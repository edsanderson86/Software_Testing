            "{{listId}}"
          ],
          "query": [
            {
              "key": "key",
              "value": "{{apiKey}}"
            },
            {
              "key": "token",
              "value": "{{apiToken}}"
            },
            {
              "key": "name",
              "value": "In Progress"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('List updated', () => pm.response.to.have.status(200));",
              "pm.test('New list name returned', () => pm.expect(pm.response.json().name).to.eql('In Progress'));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Update card",
      "request": {
        "method": "PUT",
        "url": {
          "raw": "https://api.trello.com/1/cards/{{cardId}}",
          "protocol": "https",
          "host": [
            "api",
