          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Updated board persisted', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().name).to.eql(pm.collectionVariables.get('updatedBoardName'));",
              "});"
            ]
