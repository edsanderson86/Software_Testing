            },
            {
              "key": "token",
              "value": "{{apiToken}}"
            },
            {
              "key": "name",
              "value": "Updated {{cardName}}"
            },
            {
              "key": "desc",
              "value": "Updated by API test"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Card updated', () => pm.response.to.have.status(200));",
