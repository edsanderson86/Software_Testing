            "exec": [
              "pm.test('Deleted board is unavailable', () => pm.response.to.have.status(404));",
              "pm.collectionVariables.unset('boardId');",
              "pm.collectionVariables.unset('listId');",
              "pm.collectionVariables.unset('cardId');"
            ]
          }
        }
      ]
