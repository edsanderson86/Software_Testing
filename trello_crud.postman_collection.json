            ]
          }
        }
      ]
    },
    {
      "name": "10 Confirm updates",
      "request": {
        "method": "GET",
        "url": {
          "raw": "https://api.trello.com/1/boards/{{boardId}}",
          "protocol": "https",
          "host": [
